{
  // Tool Inventar – Cloudflare Worker mit statischer App, D1 und R2 (Vorbild: Adventkalender/Einladung)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool-inventar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "inventar.cleebration.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventar",
      // angelegt 2026-11-04 (Westeuropa), Migrationen 0001+0002 eingespielt
      "database_id": "417c04fe-86a8-4b96-9f81-6db3886a2565",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "inventar-fotos-eu" } // Westeuropa (WEUR), angelegt 2026-11-04
  ],
  // nachts: abgelaufene Sitzungen + gelöschte Konten aufräumen (DSGVO, Kit)
  "triggers": { "crons": ["17 3 * * *"] }
}
